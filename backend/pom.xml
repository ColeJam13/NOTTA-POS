<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Project Identification -->
    <groupId>com.notapos</groupId>
    <artifactId>nota-pos-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Nota-POS Backend</name>
    <description>Restaurant POS System with Order Delay Timer - Built by CJ</description>
        <!-- Spring Boot Parent - Manages all Spring Boot dependencies -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.3</version>
        <relativePath/>
    </parent>

    <!-- Java Version -->
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    
       <!-- Dependencies -->
    <dependencies>
        <!-- Spring Boot Web - REST API support (Spring MVC on an embedded Tomcat, and JSON).
             Spring Boot 4 renamed this starter from "spring-boot-starter-web" to say which
             web framework it is. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Spring Boot Data JPA - Database ORM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC Driver - Database connection -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Bean Validation - Input validation (@NotNull, @Size, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Flyway: runs the numbered SQL files in src/main/resources/db/migration at
             start-up, in order, and remembers which have run. The second dependency
             is Flyway's PostgreSQL support, which is packaged separately.

             Since Spring Boot 4, the part of Spring Boot that RUNS Flyway at start-up is
             its own module, and this starter brings it together with Flyway itself.
             With only "flyway-core" here, as before, Flyway would be on the classpath
             and nothing would run it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Security: decides who is asking (authentication) and what they may do
             (authorization) for every request. It also brings the BCrypt hashing used for
             staff PINs, which used to be pulled in on its own as spring-security-crypto.
             The rules are in config/SecurityConfig. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Boot DevTools - Hot reload during development -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Testing. Spring Boot 4 split its test support into one starter per technology,
             each bringing JUnit, Mockito, AssertJ, and the test helpers for that part:
               webmvc-test    MockMvc, @WebMvcTest, @AutoConfigureMockMvc (controller and
                              integration tests)
               data-jpa-test  @DataJpaTest (repository tests)
             (Before 4.0 the single "spring-boot-starter-test" covered all of these.)
             There are more of them (security-test, flyway-test, ...). The whole suite was
             run without those two and passes, so they are not listed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: starts a real PostgreSQL in Docker for the repository and
             integration tests. Spring Boot chooses the version (2.x since Spring Boot 4;
             its modules were renamed with a "testcontainers-" prefix in 2.0). -->
        <!-- Testcontainers Core - Docker container management for tests -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers JUnit 5 - Integration with JUnit 5 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers PostgreSQL - PostgreSQL-specific container -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
        <!-- Build Configuration -->
    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin - Packages as executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        The packaged build: ONE runnable file with the frontend inside it.

        A "profile" is a set of build settings that only applies when it is asked for by
        name:  mvn -Ppackaged package.  Everyday commands (mvn test, mvn spring-boot:run)
        do not ask for it and are not changed by it.

        Use ../package.sh, not this profile directly. The script builds the frontend
        first (this profile only copies what that build left in frontend/build) and
        checks the result.

        What the profile does:
          1. Builds into backend/target-packaged, not backend/target, so making a package
             never disturbs a backend that is running from target/ at the same time.
          2. Copies the built frontend into the jar under static/. Spring Boot serves
             whatever is in that folder, so the one program answers both the app's pages
             and its API (see WebConfig and SecurityConfig.FRONTEND_FILES).
          3. Names the result notta-pos.jar.
    -->
    <profiles>
        <profile>
            <id>packaged</id>
            <build>
                <directory>${project.basedir}/target-packaged</directory>
                <finalName>notta-pos</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-built-frontend</id>
                                <!-- "prepare-package" is the step just before the jar is made -->
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/../frontend/build</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>